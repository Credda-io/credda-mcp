{
  "name": "@credda/mcp-server",
  "version": "1.0.0",
  "mcpName": "io.github.Credda-io/credda",
  "description": "MCP server for reading what Credda found in your repositories: investigations, evidence, resolution records and validation findings. Read-only: it cannot start a run or open a pull request.",
  "license": "MIT",
  "homepage": "https://github.com/Credda-io/credda-mcp#readme",
  "bugs": {
    "url": "https://github.com/Credda-io/credda-mcp/issues",
    "email": "martin@credda.io"
  },
  "type": "module",
  "bin": {
    "credda-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Credda-io/credda-mcp.git"
  },
  "keywords": [
    "credda",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "bug-finding",
    "security-vulnerabilities",
    "root-cause-analysis",
    "code-review"
  ],
  "engines": {
    "node": ">=18"
  }
}
